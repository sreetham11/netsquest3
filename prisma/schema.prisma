// NETS Quest data model. All money is stored as integer cents.
// Every user-scoped model carries `userId` = the Supabase auth user id (uuid
// string). Auth users live in Supabase's managed `auth` schema, so userId is a
// plain indexed string here, not a Prisma relation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One simulated wallet per user.
model Account {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  currency     String   @default("SGD")
  rewardPoints Int      @default(0) // 5 pts per S$1 of NETS payment, see src/lib/rewards.ts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auto top-up: single settings blob per account, not a separate table —
  // there's exactly one of these per user, so it belongs alongside
  // balanceCents/rewardPoints as scalar Account state. Threshold/amount are
  // nullable rather than defaulting to 0: null means "never configured",
  // distinct from a real (if unlikely) 0 value. See triggerAutoTopupIfNeeded
  // in src/lib/autoTopup.ts for the trigger logic.
  //
  // These columns already exist in the live (shared) database — added by
  // another codebase's migration on this same Supabase project — this just
  // declares them so Prisma Client on this branch can read/write them too.
  // No new migration needed.
  autoTopupEnabled        Boolean @default(false)
  autoTopupThresholdCents Int?
  autoTopupAmountCents    Int?
}

// Simulated money movement. amountCents < 0 = debit/spend, > 0 = credit.
model Transaction {
  id               String   @id @default(cuid())
  userId           String
  description      String
  category         String
  amountCents      Int
  type             TxnType  @default(PAYMENT)
  // Overseas fields (set when the spend happened abroad).
  country          String?
  currencyLocal    String?
  amountLocalCents Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

enum TxnType {
  PAYMENT
  TOPUP
  TRANSFER
  VAULT
  BILL
  REWARD
  INCOME
}

// Instant bill/receipt split among named participants — no invites, no real
// linked accounts, participants are names only. "paid" is a status toggle
// only (no real payment processing, no balance/points effect).
model Split {
  id               String             @id @default(cuid())
  ownerId          String
  title            String
  totalAmountCents Int
  category         String             @default("General")
  createdAt        DateTime           @default(now())
  participants     SplitParticipant[]

  // --- Spin to Decide -------------------------------------------------------
  // One spin, one outcome: who FRONTS the bill. Every other participant then
  // owes that payer their unchanged share, so nobody absorbs 100% of the bill.
  // "Owes payer" is DERIVED from the existing shareAmountCents — no money
  // fields are duplicated and the base split math is untouched.
  //
  // References SplitParticipant.id. Kept as a plain id rather than a Prisma
  // relation to avoid a circular Split <-> SplitParticipant relation (and the
  // delete-ordering hazard that comes with it); the Server Action only ever
  // writes an id belonging to this split.
  //
  // spunAt set == already spun. A split may be spun ONCE.
  payerParticipantId String?
  spunAt             DateTime?

  @@index([ownerId])
}

model SplitParticipant {
  id               String  @id @default(cuid())
  splitId          String
  name             String
  shareAmountCents Int
  paid             Boolean @default(false)
  split            Split   @relation(fields: [splitId], references: [id], onDelete: Cascade)

  // A participant is EITHER a saved Contact or a genuine one-off freeform
  // name. `name` is always written (and never rewritten afterwards) so a
  // split's history stays readable even if the contact is later renamed or
  // deleted — hence onDelete: SetNull rather than Cascade. Deleting a contact
  // must never delete or blank out a past split.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([splitId])
  @@index([contactId])
}

// A saved payee the user manages themselves — no invites, no real accounts,
// no lookup against any directory. phoneNumber is COSMETIC ONLY: it is
// displayed PayNow-style so a saved payee looks familiar, and is never used
// for messaging, notifications, or matching to another user.
model Contact {
  id           String             @id @default(cuid())
  userId       String
  name         String
  phoneNumber  String?
  createdAt    DateTime           @default(now())
  participants SplitParticipant[]

  @@index([userId])
}

// Per-user reward tiers, keyed to monthly NETS-payment COUNT (not spend $).
// Deliberate: tiers reward payment-method consistency ("choose NETS often"),
// not purchase volume — spending more shouldn't be what levels you up.
// Current point balance lives on Account.rewardPoints.
model RewardTier {
  id             String @id @default(cuid())
  userId         String
  name           String
  perk           String
  txnCountNeeded Int
  sortOrder      Int    @default(0)

  @@index([userId])
}

// Fixed demo catalogue of redeemable rewards — global, not per-user. Tangible
// items (coffee, a movie ticket) read as more motivating than an equivalent
// cashback %, even at the same underlying value.
model Reward {
  id          String       @id @default(cuid())
  name        String       @unique
  pointCost   Int
  category    String // maps to an Icon in the UI: coffee, bubble-tea, fast-food, movie-ticket, voucher
  sortOrder   Int          @default(0)
  redemptions Redemption[]
}

// Merchant cashback marketplace — fixed demo catalogue, global not per-user.
// Same shape as Reward (name, category, offer, sortOrder) for consistency.
// Static/seeded for the demo; not a live merchant API.
model MerchantDeal {
  id        String @id @default(cuid())
  merchant  String @unique
  category  String // maps to an Icon in the UI: food, grocery, convenience, cafe, ride, pharmacy, cinema
  offer     String // e.g. "10% off", "Free delivery", "5% cashback"
  sortOrder Int    @default(0)
}

// A user's redemption history. Persisted (not just an in-memory point
// deduction) so a reload still shows the reward as redeemed.
model Redemption {
  id          String   @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  createdAt   DateTime @default(now())
  reward      Reward   @relation(fields: [rewardId], references: [id])

  @@index([userId, createdAt])
}

// Per-user, per-category monthly spending cap.
model BudgetCap {
  id         String   @id @default(cuid())
  userId     String
  category   String
  limitCents Int
  createdAt  DateTime @default(now())

  @@unique([userId, category])
}

// Recurring bill the user can pay (simulated).
model RecurringBill {
  id            String    @id @default(cuid())
  userId        String
  name          String
  category      String
  amountCents   Int
  dueDayOfMonth Int
  autopay       Boolean   @default(false)
  lastPaidAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}
